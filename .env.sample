# Standalone Brick Work. Environment overrides data/.env.
BW_DB_PATH=data/brickwork.db
BW_HOST=0.0.0.0
BW_PORT=3333
# Behind a reverse proxy: the number of proxy hops whose X-Forwarded-* headers to trust (0 = none).
BW_TRUSTED_PROXIES=0
# Required unless BW_ALLOW_NO_LOGIN=1. The session key is generated into data/session.key when empty.
BW_AUTHENTICATION_PASSWORD=
BW_AUTHENTICATION_KEY=
# BW_ALLOW_NO_LOGIN=1
# Behind HTTPS: send the session cookie only over HTTPS.
# BW_SECURE_COOKIES=1
BW_API_TOKEN=
# Generate a Fernet key; required to enter encrypted source keys in the app.
BW_SECRET_KEY=
BW_EMBEDDED_WORKER=1
BW_BRICKLINK_DAILY_BUDGET=4400
BW_REBRICKABLE_DAILY_BUDGET=1000
BW_BRICKOGNIZE_DAILY_BUDGET=100
# Optional environment credentials override a stored source bundle.
BW_BRICKLINK_CONSUMER_KEY=
BW_BRICKLINK_CONSUMER_SECRET=
BW_BRICKLINK_TOKEN_VALUE=
BW_BRICKLINK_TOKEN_SECRET=
BW_REBRICKABLE_API_KEY=
BW_BRICKSET_API_KEY=

# Failed login / API token back-off (per client): failures before waiting, longest wait in seconds
# BW_LOGIN_MAX_FAILURES=5
# BW_LOGIN_MAX_DELAY=300

# Pictures and PDFs under <BW_MEDIA_PATH>/data/ (default: beside the database)
# BW_MEDIA_PATH=/media/brickwork
